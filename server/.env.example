PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/retalla
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

ADMIN_NAME=Retalla Admin
ADMIN_EMAIL=admin@retalla.in
ADMIN_PASSWORD=Admin@12345

# Gmail SMTP (or any SMTP provider) for forgot-password OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Retalla <no-reply@retalla.in>

# Firebase service account JSON (single-line, from Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=
