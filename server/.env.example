PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/retalla
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=30m
NODE_ENV=development

ADMIN_NAME=Retalla Admin
ADMIN_EMAIL=admin@retalla.in
ADMIN_PASSWORD=Admin@12345

# Brevo (https://brevo.com) transactional email API for forgot-password OTP emails.
# Render blocks outbound raw SMTP, so this uses Brevo's HTTPS API instead of SMTP.
# BREVO_SENDER_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Retalla

# Firebase service account JSON (single-line, from Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=
